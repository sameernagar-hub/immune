# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# The filled-in version is sent over a private channel: ask Lane A to run
# `npm run team:env`, which writes `team-env.txt` for exactly this purpose.
# Everyone on the team uses the SAME cluster and the SAME database — the demo
# is one shared memory being attacked, so a private copy defeats the point.

# --- MongoDB Atlas (organiser sandbox cluster) ---
# Atlas UI -> cluster -> Connect -> Drivers
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Fallback used automatically when the SRV lookup is refused by the network.
# Same cluster, addressed by its shard hosts, with an explicit replicaSet.
# Some venue and conference networks block DNS SRV queries even when ordinary
# name resolution works fine, which makes mongodb+srv:// fail on a healthy link.
# This is not optional at the venue — it is the string that actually connects.
MONGODB_URI_DIRECT=""

MONGODB_DB="immune"

# --- Embeddings (optional) ---
# With no key set, src/embed.js uses its built-in deterministic lexical
# embedder. The demo runs fully offline and byte-identically without this.
# We are shipping with this empty: no OpenRouter credit was available, and the
# deterministic rung is the honest thing to demo. See README.
OPENROUTER_API_KEY=""
EMBED_MODEL="openai/text-embedding-3-small"

# --- Optional: claim extraction via LLM (falls back to deterministic rules) ---
OPENROUTER_MODEL="anthropic/claude-3.5-haiku"

# --- ElevenLabs (Tier 3: the agent narrates its own diagnosis) ---
# Only speaks when IMMUNE_VOICE=1, so `npm run rehearse` stays byte-identical.
# `npm run voice:warm` pre-synthesises every line to .immune-cache/voice.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"
ELEVENLABS_MODEL="eleven_turbo_v2_5"

# --- Live audience surface (npm run live) ---
IMMUNE_LIVE_PORT="4173"
